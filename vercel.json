{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/notify?slot=morning",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/notify?slot=noon",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/notify?slot=evening",
      "schedule": "0 16 * * *"
    }
  ]
}
